<?xml version="1.0" encoding="utf-8"?>
<!--
  局域网模式下 /api/* 打的是桌面在 192.168.x.x:30035 上明文监听的 HTTP（没有 TLS
  证书可用），Android 9+（targetSdk >= 28）默认整个应用禁止明文流量，不放开的话
  一条请求都发不出去。

  地址是运行时用户在「服务地址」输入框里填的（Task 3），构建期不知道具体是哪一个
  局域网 IP，没法用 <domain-config> 精确到单个域名/IP——那需要提前写死一个地址，
  跟「让用户自己填」这个设计矛盾。<domain-config> 也不支持 CIDR/网段匹配，没有
  「只放行私有网段」这个选项。

  所以退到能用的最窄单位：只放开明文，不改别的默认值（HSTS、证书校验等原生行为
  都还在）。这不等同于「完全不设防」——WebView 里加载的仍然只是本机内置的
  web/dist，不是能被劫持去任意加载外部页面的浏览器；风险点在于同一局域网内的人
  能看到/篡改明文流量，这个风险在 server 端 LAN=1 那句启动提示里说清楚（Task 4），
  不是这份 manifest 能兜住的。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
