# 换端口就改这一行。默认 30035。
# 注意：写在这个文件里，不要在命令行里写 `PORT=30045 npm start`——
# 那是 POSIX shell 语法，Windows 的 cmd 和 PowerShell 都跑不通。
PORT=30035

# 启动时不自动开浏览器
# NO_OPEN=1

# 局域网模式：手机要连这台机器的服务才需要开。默认不设——不开的话服务只绑
# 127.0.0.1，只有这台机器自己能连。开了之后同一个 Wi-Fi 下的任何设备都能读写
# 你的全部任务，没有任何认证，只在家庭 Wi-Fi 上开，见 README「手机」一节。
# LAN=1

# 提醒轮询间隔（毫秒），默认 30000。手工验证提醒时临时调小用。
# REMIND_INTERVAL_MS=5000

# Windows 通知用的 AppID。默认用 Windows PowerShell 自己的，一般不用改。
# TOAST_APPID=
