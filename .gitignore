node_modules/
dist/

# npm run dist:desktop 的打包产物（exe/安装包，几十上百 MB，不该进仓库）
desktop/release/

# 你的数据：收件箱原文、任务、设置。丢了就没有，也绝不该跟着仓库跑。
data/

# 端口等本机配置，样板见 .env.example
.env

# 工具状态（本机会话记录、权限缓存）。commands/ 例外——那是要进版本库的斜杠命令，
# 跟 workflows/ 下的正文配套。
.claude/*
!.claude/commands/
.superpowers/
*.bak

# 三份参照 App 的官方帮助文档（滴答清单 / Things / OmniFocus）的本地副本。
# **是别人的东西，不跟着这个仓库发布**——原样转载第三方帮助中心，跟仓库自己的
# MIT 许可是两回事。注释里引用它们一律写原站链接（每篇抓下来时都记了 `url:`），
# 那种引用对任何人都成立，不需要仓库里存一份副本。
#
# 本地留着照旧有用：改「仿滴答清单」那类实现前先去查一句原文，比点开网页快。
docs/
